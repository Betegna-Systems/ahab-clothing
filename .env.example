# Supabase → Project Settings → API
VITE_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-public-key"
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
# Server-side public auth key used to initialize the browser client at runtime.
SUPABASE_PUBLISHABLE_KEY="your-anon-public-key"

# Optional: connection string from Project Settings → Database (for drizzle)
# DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres"

# Cloudinary
VITE_CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Telegram order alerts (server-only)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# Public canonical address used for SEO links, sitemap and share previews
VITE_SITE_URL=https://www.ahabclothing.com

# Customer order emails via Resend (server-only). Off until both are set.
# ORDER_EMAIL_FROM must use a domain verified in Resend.
RESEND_API_KEY=""
ORDER_EMAIL_FROM="AHAB Clothing <orders@ahabclothing.com>"
# Optional: where customer replies go
ORDER_EMAIL_REPLY_TO=""
